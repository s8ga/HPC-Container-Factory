# Mirror Builder Image for HPC-Container-Factory
# Purpose: Generic Spack-only Fedora 45 GA image shared by all environments.
#          System packages and mirror setup are installed at runtime by hpc_cf
#          reading from spack-envs/<env>/env.yaml.
#
# Build:
#   podman build -t hpc-mirror-builder -f containers/Dockerfile.mirror-builder .
#
# This image is env-agnostic — one build serves all spack-envs/.

ARG BASE_IMAGE=registry.fedoraproject.org/fedora-minimal:45@sha256:05477647a380afaacc612d14f8fad016a604a7ff444dbc0f6b5a55f68a93403f
FROM ${BASE_IMAGE}

LABEL maintainer="s8ga" \
      description="Spack mirror builder — generic Fedora 45 Spack-only image (shared by all envs)"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SPACK_PYTHON=/usr/bin/python3.13

ARG PKG_MIRROR=mirrors.ustc.edu.cn

# Freeze to Fedora GA repos (disable updates* and openh264 so concretization
# toolchain never drifts or hits third-party CDNs) and rewrite metalink/baseurl
# when a local PKG_MIRROR host is configured.
# Note: fedora-minimal:45 stores repo definitions under /usr/share/dnf5/repos.d/.
RUN sed -i 's|^enabled=1|enabled=0|g' \
        /usr/share/dnf5/repos.d/*updates*.repo /etc/yum.repos.d/*updates*.repo \
        /usr/share/dnf5/repos.d/*openh264*.repo /etc/yum.repos.d/*openh264*.repo 2>/dev/null || true && \
    if [ -n "${PKG_MIRROR}" ] && [ "${PKG_MIRROR}" != "official" ]; then \
        sed -i -e 's|^metalink=|#metalink=|g' \
               -e "s|^#baseurl=https\?://download\.example/pub/fedora/linux|baseurl=https://${PKG_MIRROR}/fedora|g" \
               -e "s|^baseurl=https\?://download\.fedoraproject\.org/pub/fedora/linux|baseurl=https://${PKG_MIRROR}/fedora|g" \
               /usr/share/dnf5/repos.d/fedora*.repo /etc/yum.repos.d/fedora*.repo 2>/dev/null || true; \
    fi && \
    dnf5 install -y --setopt=install_weak_deps=0 --disablerepo='updates*,fedora-cisco-openh264' \
        python3 \
        python3.13 \
        python3-pyyaml \
        ca-certificates \
        git \
        sudo \
        gcc \
        gcc-c++ \
        gcc-gfortran \
        make \
        patch \
        tar \
        gzip \
        bzip2 \
        xz \
        which \
        findutils \
        diffutils \
        file \
        procps-ng \
    && dnf5 clean all && rm -rf /var/cache/libdnf5 /var/cache/dnf /var/cache/yum

# Allow any user to sudo without password (needed for runtime system pkg install)
RUN echo "ALL ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ── Spack is NOT pre-installed ──────────────────────────────────────────
# It is extracted at runtime by SpackOps._source_spack() in hpc_cf/spack_ops.py,
# using the version declared in each env's env.yaml → spack.version.
# assets/ is bind-mounted from host, so all spack-v*.tar.gz files are available.
#
# Pre-create /opt with write permissions for non-root spack extraction.
RUN mkdir -p /opt && chmod a+w /opt

# NOTE: /root/.spack/package_repos pre-clone REMOVED.
# Since HOME=/tmp/home at runtime, pre-cloning to /root/.spack is useless.
# SpackOps.bootstrap_mirror() will handle first-run clingo bootstrap instead.

# Create working directory for mounted project
RUN mkdir -p /work

WORKDIR /work

# Create entrypoint script — no Spack sourcing (done at runtime by SpackOps).
RUN printf '#!/bin/bash\n\
exec "$@"\n' > /opt/entrypoint.sh && chmod +x /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
