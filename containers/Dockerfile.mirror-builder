# Mirror Builder Image for HPC-Container-Factory
# Purpose: Generic Spack-only image shared by all environments.
#          System packages and mirror setup are installed at runtime by hpc_cf
#          reading from spack-envs/<env>/env.yaml.
#
# Build:
#   podman build -t hpc-mirror-builder -f containers/Dockerfile.mirror-builder .
#
# This image is env-agnostic — one build serves all spack-envs/.

ARG BASE_IMAGE=debian:trixie
FROM ${BASE_IMAGE}

LABEL maintainer="s8ga" \
      description="Spack mirror builder — generic Spack-only image (shared by all envs)"

RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|security.debian.org|mirrors.ustc.edu.cn/debian-security|g' /etc/apt/sources.list 2>/dev/null || true

# ── Minimal system deps for Spack (it needs python3 + yaml to run) ─────────
# Full system packages (compilers, libs, etc.) are installed at runtime
# by hpc_cf (SpackOps.install_system_pkgs) reading env.yaml — NOT baked into this image.
# However, build-essential is needed because spack bootstrap mirror
# requires concretize (which needs a system compiler for target detection).
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-yaml \
        ca-certificates \
        git \
        sudo \
        build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Allow any user to sudo without password (needed for runtime system pkg install)
RUN echo "ALL ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ── Spack is NOT pre-installed ──────────────────────────────────────────
# It is extracted at runtime by SpackOps._source_spack() in hpc_cf/spack_ops.py,
# using the version declared in each env's env.yaml → spack.version.
# assets/ is bind-mounted from host, so all spack-v*.tar.gz files are available.
#
# Pre-create /opt with write permissions for non-root spack extraction.
RUN mkdir -p /opt && chmod a+w /opt

# NOTE: /root/.spack/package_repos pre-clone REMOVED.
# Since HOME=/tmp/home at runtime, pre-cloning to /root/.spack is useless.
# SpackOps.bootstrap_mirror() will handle first-run clingo bootstrap instead.

# Create working directory for mounted project
RUN mkdir -p /work

WORKDIR /work

# Create entrypoint script — no Spack sourcing (done at runtime by SpackOps).
RUN printf '#!/bin/bash\n\
exec "$@"\n' > /opt/entrypoint.sh && chmod +x /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
