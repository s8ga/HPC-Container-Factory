# Multi-stage Dockerfile for CP2K + Opensource BLAS 2026.2 with Spack
# BUILD REQUIREMENTS:
# - assets/ directory with spack-v{{ spack_version }}.tar.gz, bootstrap-{{ spack_version }}, spack-mirror (optional)
# - spack-envs/{{ env_dir_name }}/spack-env-file with spack.yaml and spack.lock
#
# NOTE: Do not reorder or edit RUN steps within each stage; that breaks Docker layer cache.

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

# ============================================================================
# STAGE 1: BUILDER-INSTALLED - CP2K compilation environment before cleanup
# ============================================================================
# builder_base_image comes from env.yaml images.builder (prefer tag@sha256:…).
FROM {{ builder_base_image }} AS builder-installed

LABEL stage="builder-installed" \
      description="Installed stage: Compiles CP2K 2026.2 with Spack" \
      maintainer="s8ga"

# ============================================================================
# BUILDER BASE - common Spack prelude (APT + install + bootstrap + mirror)
# ============================================================================
{% include 'partials/spack_builder_prelude_debian.j2' %}

# ============================================================================
# CP2K-SPECIFIC BUILD
# ============================================================================

# Fetch CP2K source — only the directories needed for regtesting.
# Uses sparse checkout to avoid downloading the full ~1GB+ repo.
# The actual build comes from spack (source mirror), not this clone.
# Branch {{ cp2k_branch }} is pinned at {{ cp2k_dev_repo_commit }} (env.yaml).

RUN git clone --filter=blob:none --no-checkout \
        https://github.com/cp2k/cp2k.git /opt/cp2k && \
    cd /opt/cp2k && \
    git fetch --depth 1 origin "{{ cp2k_dev_repo_commit }}" && \
    git fetch --depth 1 origin "{{ cp2k_branch }}:refs/remotes/origin/{{ cp2k_branch }}" && \
    git sparse-checkout init --cone && \
    git sparse-checkout set tests src/grid/sample_tasks tools/regtesting tools && \
    git checkout "{{ cp2k_dev_repo_commit }}" && \
    git merge-base --is-ancestor HEAD "origin/{{ cp2k_branch }}" || \
      { echo "ERROR: pinned commit $(git rev-parse HEAD) is not on {{ cp2k_branch }}"; exit 1; } && \
    echo "✅ Sparse checkout done: $(du -sh /opt/cp2k | cut -f1)"

# Fetch the force-AVX512 package overrides at the pinned s8ga monorepo commit.
RUN git clone --filter=blob:none --sparse --no-checkout \
        "{{ force_avx512_repo_url }}" /opt/s8ga-spack-packages && \
    cd /opt/s8ga-spack-packages && \
    git fetch --depth 1 origin "{{ s8ga_repo_commit }}" && \
    git sparse-checkout set "{{ force_avx512_repo_path }}" && \
    git checkout "{{ s8ga_repo_commit }}"

{% include 'partials/spack_env_create.j2' %}
{% include 'partials/spack_update_builtin.j2' %}
{% include 'partials/spack_compiler_find.j2' %}

# Stage CP2K spack recipes into the path expected by plan image_path
# (default_image_path → /opt/spack-repo/spack_repo/<leaf>).
RUN mkdir -p /opt/spack-repo/spack_repo/ && \
    cp -a /opt/cp2k/{{ cp2k_dev_repo_path }}/ /opt/spack-repo/spack_repo/

# Repo priority: builtin < CP2K dev < s8 force-AVX512 < local CP2K 2026.2.
# Paths come from plan (custom_repos[].image_path via spack_image_repos).
{% include 'partials/spack_image_repos.j2' %}

RUN spack -e {{ spack_env_name }} repo ls

{% include 'partials/spack_zlib_fix.j2' %}
{% include 'partials/spack_buildcache_config.j2' %}

{% if spack_buildcache_policy in ['auto', 'only'] %}
{% set libint_parallel_cap = 12 %}
{% include 'partials/spack_buildcache_install.j2' %}
{% else %}
# CP2K 2026.2+ ships *pregenerated* libint sources (cp2k-lmax-*), not prebuilt
# binaries — libint still must be compiled. Cap -j at 12 for peak memory.
RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
        libint_jobs="$(nproc)"; \
        if [ "${libint_jobs}" -gt 12 ]; then libint_jobs=12; fi; \
        echo "Installing libint with -j ${libint_jobs} (memory-capped)..."; \
        spack -e {{ spack_env_name }} install --fail-fast -j "${libint_jobs}" -p 20 libint && \
        echo "Installing remaining packages with -j $(nproc)..."; \
        spack -e {{ spack_env_name }} install --fail-fast -j "$(nproc)" -p 20;
{% endif %}

# ============================================================================
# STAGE 2: BUILDER - Existing post-install/debug checkpoint
# ============================================================================
FROM builder-installed AS builder

LABEL stage="builder" \
      description="Builder stage: post-install CP2K debug image" \
      maintainer="s8ga"

{% set build_manifest_title = "CP2K 2026.2 Build Manifest" %}
{% include 'partials/spack_post_install.j2' %}

{% if not build_only %}
# ============================================================================
# STAGE 3: RUNTIME - Minimal container with only CP2K and runtime libraries
# ============================================================================
FROM {{ runtime_base_image }} AS runtime

LABEL stage="runtime" \
      description="Runtime stage: Minimal container with CP2K 2026.2 only" \
      maintainer="s8ga"

# Spack view provides all binaries and libraries via symlinks.
# PATH points to the view for transparent binary access.
# LD_LIBRARY_PATH is intentionally NOT set — we rely solely on ldconfig
# (registered via /etc/ld.so.conf.d/cp2k.conf) for library discovery.
# CP2K_DATA_DIR points to data files installed by spack (basis sets, potentials).
# GAUXC_SKALA_MODEL: required when input uses MODEL SKALA (GauXC +skala); the
# .fun file is installed by the gauxc package into the env view.

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/spack-view/bin:/opt/bin:$PATH" \
    CP2K_DATA_DIR="/opt/spack-view/share/cp2k/data" \
    GAUXC_SKALA_MODEL="/opt/spack-view/share/gauxc/onedft_models/skala-1.1.fun"

{% include 'partials/runtime_apt_debian.j2' %}

# Create non-root user for security (before COPY to use --chown)
RUN useradd -m -s /bin/bash hpc

# Copy spack install tree and view from builder.
# NOTE: Docker COPY preserves symlinks — the view's symlinks will point correctly
# because we copy the install tree first, then the view on top.
WORKDIR /opt

# 1. Spack install tree (real files: binaries, libraries, data)
COPY --from=builder --chown=hpc:hpc /opt/spack /opt/spack

# 2. Spack view (symlinks into /opt/spack, provides unified bin/lib/share layout)
COPY --from=builder --chown=hpc:hpc /opt/spack-view /opt/spack-view

# Fail the image build if Skala checkpoint is missing from the view (MODEL SKALA).
RUN test -f "${GAUXC_SKALA_MODEL}"

# 3. CP2K test files for regtesting (sparse-checkout from git clone in builder)
COPY --from=builder --chown=hpc:hpc /opt/cp2k/tests /opt/cp2k/tests
COPY --from=builder --chown=hpc:hpc /opt/cp2k/src/grid/sample_tasks /opt/cp2k/src/grid/sample_tasks
COPY --from=builder --chown=hpc:hpc /opt/cp2k/tools/regtesting /opt/cp2k/tools/regtesting

# Register spack library paths with ldconfig for system-wide discovery.
RUN { echo "/opt/spack-view/lib"; } > /etc/ld.so.conf.d/cp2k.conf && \
    ldconfig

{% include 'partials/runtime_cleanup.j2' %}

# Create workspace directory
RUN mkdir -p /workspace && chown hpc:hpc /workspace

WORKDIR /workspace

USER hpc

# ============================================================================
# STAGE 4: FINAL - Alias for runtime (for backward compatibility)
# ============================================================================
FROM runtime AS final

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

LABEL version="2026.2" \
      description="Optimized CP2K 2026.2 container" \
      maintainer="s8ga" \
      image_name="{{ default_image_name }}" \
      image_tag="{{ default_image_tag }}" \
      timestamp="{{ timestamp }}"

ENV HPC_CONTAINER_NAME="{{ default_image_name }}" \
    HPC_CONTAINER_TAG="{{ default_image_tag }}" \
    HPC_CONTAINER_BUILD_TS="{{ timestamp }}"

ENV MPI_RUNVAR=" --bind-to none "

# MOTD system: shown only for interactive shell sessions.
COPY --chmod=755 scripts/cp2k-motd.sh /usr/local/bin/hpc-motd.sh
COPY --chmod=755 scripts/cp2k-entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]

{% endif %}

# ============================================================================
# END OF DOCKERFILE
# ============================================================================
