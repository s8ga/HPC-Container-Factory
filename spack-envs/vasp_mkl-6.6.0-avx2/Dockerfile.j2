# Multi-stage Dockerfile for VASP 6.6.0 + Intel MKL with Spack
# BUILD REQUIREMENTS:
# - assets/ directory with spack-v{{ spack_version }}.tar.gz, bootstrap-{{ spack_version }}, spack-mirror (optional)
# - spack-envs/{{ env_dir_name }}/spack-env-file with spack.yaml and spack.lock
# - assets/manual-packages/vasp.6.6.0.tgz (private source, not in spack-mirror)
#
# NOTE: 不要修改各 stage 内的 RUN 步骤，否则会破坏构建缓存。

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

# ============================================================================
# STAGE 1: BUILDER - VASP compilation environment
# ============================================================================
FROM {{ builder_base_image }} AS builder

LABEL stage="builder" \
      description="Builder stage: Compiles VASP 6.6.0 with Spack" \
      maintainer="s8ga"

# ============================================================================
# BUILDER BASE - Common initialization
# ============================================================================

# Configure APT mirrors to use USTC (中科大) for faster downloads in China
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|security.debian.org|mirrors.ustc.edu.cn/debian-security|g' /etc/apt/sources.list 2>/dev/null || true

# System dependencies for Spack and compilation
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    environment-modules \
    gfortran \
    git \
    openssh-client \
    pkg-config \
    unzip \
    wget \
    cmake \
    file \
    automake \
    bzip2 \
    xxd \
    xz-utils \
    zstd \
    ninja-build \
    patch \
    patchelf \
    pkgconf \
    libtool-bin \
    python3 \
    python3-pip \
    python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt

# Copy pre-downloaded Spack from assets and extract in builder container
COPY assets/spack-v{{ spack_version }}.tar.gz /tmp/spack.tar.gz

ENV SPACK_ROOT=/opt/spack-exe

RUN cd /opt && \
    mkdir ${SPACK_ROOT} && \
    tar -axf /tmp/spack.tar.gz --strip-components=1 -C ${SPACK_ROOT} && \
    rm /tmp/spack.tar.gz && \
    cd ${SPACK_ROOT} && \
    ls -la bin/ lib/ var/

ENV PATH="${SPACK_ROOT}/bin:${PATH}"

# Configure Spack to use local bootstrap mirror.
COPY assets/bootstrap-{{ spack_version }} /opt/bootstrap

RUN . ${SPACK_ROOT}/share/spack/setup-env.sh && \
    spack bootstrap add --trust local-sources /opt/bootstrap/metadata/sources && \
    spack bootstrap add --trust local-binaries /opt/bootstrap/metadata/binaries && \
    spack bootstrap disable github-actions-v2 && \
    spack bootstrap disable github-actions-v0.6 && \
    spack bootstrap disable spack-install && \
    spack bootstrap now && \
    spack bootstrap list && \
    spack --version && \
    echo "✅ Spack bootstrap configured from local mirror"
{% if use_mirror %}
# Register local mirror as primary source (highest priority)
RUN --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    . ${SPACK_ROOT}/share/spack/setup-env.sh && \
    spack mirror add --scope site local-mirror file:///opt/spack-mirror && \
    spack mirror list && \
    echo "✅ Local source mirror configured at /opt/spack-mirror"
{% endif %}

# Configure build directory (actual install location set in spack.yaml)
RUN mkdir -p /opt/hpc && mkdir -p /tmp/spack-build

# ============================================================================
# VASP-SPECIFIC BUILD
# ============================================================================

# Copy manual (private) source packages into container.
# VASP's package.py has url = "file://{cwd}/vasp.6.6.0.tgz" with manual_download = True,
# so spack expects to find the tarball in the working directory.
{% for mp in manual_packages %}
COPY {{ mp.file }} {{ mp.dest }}
{% endfor %}

# Prepare VASP working directory.
# spack will find vasp.6.6.0.tgz in the current directory (manual_download)
# and handle extraction itself — no need to tar manually.
RUN mkdir -p /opt/vasp && \
    cp /opt/manual-package/vasp.6.6.0.tgz /opt/vasp/ && \
    echo "✅ VASP source tarball ready: $(ls /opt/vasp/)"

# Prepare the spack environment + configuration
COPY spack-envs/{{ env_dir_name }}/spack-env-file /opt/spack-env-file

# Create env, then import lock/config/repos from source directory.
RUN /bin/bash -c 'set -euo pipefail; \
    spack env create vasp-env /opt/spack-env-file/spack.yaml && \
    if [ -f /opt/spack-env-file/spack.lock ]; then \
        cp -f /opt/spack-env-file/spack.lock "${SPACK_ROOT}/var/spack/environments/vasp-env/spack.lock"; \
        echo "Imported existing spack.lock"; \
    else \
        echo "No spack.lock provided; install step will concretize"; \
    fi'

# Find all compilers + all external packages
RUN spack compiler find && \
    spack external find --all --not-buildable

# Add local repo with custom vasp package.py
RUN spack repo add --scope site /opt/spack-env-file/repos/ && \
    spack -e vasp-env repo ls

# Fix for OpenMPI@5.0.8: zlib not found
RUN ln -sf /usr/lib/x86_64-linux-gnu/libz.so /usr/lib/libz.so

# Pre install openmpi and intel-oneapi-mkl (needed for MKL purge step)
RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
        spack -e vasp-env install --fail-fast -j "$(nproc)" -p 20 openmpi intel-oneapi-mkl;

# Prepare fakeintel library to work around MKL's CPU dispatching issues in AMD cpus.
COPY spack-envs/{{ env_dir_name }}/libfakeintel /opt/libfakeintel/

# Output .so at /opt/libfakeintel/libfakeintel.so.
RUN make -C /opt/libfakeintel/ all

# Purge MKL's compiler and IntelMPI to reduce image size.
RUN . ${SPACK_ROOT}/share/spack/setup-env.sh && \
    spack env activate vasp-env && \
    MKL_TRUELOCATION=$(spack location -i intel-oneapi-mkl) && \
    rm -rf "${MKL_TRUELOCATION}/compiler" && \
    rm -rf "${MKL_TRUELOCATION}/mpi" && \
    find "${MKL_TRUELOCATION}" -name "libmkl_blacs_intelmpi*" -delete && \
    find "${MKL_TRUELOCATION}" -name "libmkl_blacs_sgimpt*"   -delete && \
    find "${MKL_TRUELOCATION}" -name "libmkl_intel_thread*"   -delete

# Install VASP dependencies first (excluding vasp itself).
# VASP source is already in /opt/vasp — spack finds it via manual_download.
RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
        cd /opt/vasp && \
        spack -e vasp-env install --fail-fast -j "$(nproc)" -p 20 --only dependencies;

# Install VASP itself with --keep-stage to preserve the build directory for testsuite extraction.
RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
        cd /opt/vasp && \
        spack -e vasp-env install --fail-fast -j "$(nproc)" -p 20 --keep-stage vasp;

# Extract VASP testsuite from the spack stage directory.
RUN VASP_STAGE=$(spack -e vasp-env location -s vasp) && \
    echo "VASP stage: ${VASP_STAGE}" && \
    mkdir -p /opt/vasp-testsuite && \
    cp -a "${VASP_STAGE}/spack-src/testsuite" /opt/vasp-testsuite/testsuite && \
    echo "✅ Testsuite extracted: $(du -sh /opt/vasp-testsuite/testsuite | cut -f1)"

# Build testsuite helper tool (compare_numbertable_new) in builder stage
# where gfortran is still available.
RUN cd /opt/vasp-testsuite/testsuite && \
    sed -i '/^include.*makefile\.include/d' makefile && \
    make numbertable

RUN spack -e vasp-env gc -y

# Enable spack env view to create symlinks in /opt/spack-view/ for runtime stage
RUN spack -e vasp-env env view enable /opt/spack-view

# ----------------------------------------------------------------------------
# STEP: Strip debug symbols
# ----------------------------------------------------------------------------
RUN BEFORE=$(du -sm /opt/spack/ | cut -f1) && \
    echo "=== Stripping debug symbols (${BEFORE}MB) ===" && \
    find /opt/spack -type f \( -name '*.so' -o -name '*.so.*' \) \
        -exec strip --strip-unneeded {} \; 2>/dev/null || true && \
    find /opt/spack -path '*/bin/*' -type f -print0 2>/dev/null \
        | xargs -0 -r file 2>/dev/null \
        | grep 'ELF.*executable' | cut -d: -f1 \
        | xargs -r strip --strip-all 2>/dev/null || true && \
    AFTER=$(du -sm /opt/spack/ | cut -f1) && \
    echo "✅ Stripped: ${BEFORE}MB → ${AFTER}MB (saved $((BEFORE - AFTER))MB)"

# ----------------------------------------------------------------------------
# STEP: Build manifest
# ----------------------------------------------------------------------------
RUN . ${SPACK_ROOT}/share/spack/setup-env.sh && \
    { echo "=== VASP 6.6.0 Build Manifest ==="; \
      echo "View: $(du -sh /opt/spack-view/ | cut -f1)"; \
      echo "Install tree: $(du -sh /opt/spack/ | cut -f1)"; \
      echo ""; spack find -d; } > /opt/spack-view/BUILD_MANIFEST.txt && \
    echo "=== Generating Dependency Graph ===" && \
    spack -e vasp-env graph --color --dot > /opt/spack-view/DependencyGraph.dot && \
    echo "Manifest saved: $(wc -l < /opt/spack-view/BUILD_MANIFEST.txt) lines"

{% if not build_only %}
# ============================================================================
# STAGE 2: RUNTIME - Minimal container with only VASP and runtime libraries
# ============================================================================
FROM {{ runtime_base_image }} AS runtime

LABEL stage="runtime" \
      description="Runtime stage: Minimal container with VASP 6.6.0 only" \
      maintainer="s8ga"

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/spack-view/bin:/opt/bin:$PATH"

# Configure APT mirrors to use USTC (中科大) for faster downloads in China
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|security.debian.org|mirrors.ustc.edu.cn/debian-security|g' /etc/apt/sources.list 2>/dev/null || true

# Install minimal runtime dependencies
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates \
    bash \
    python3 \
    curl \
    tar \
    libgfortran5 \
    libstdc++6 \
    libgcc-s1 \
    libnuma1 \
    openssh-client \
    util-linux \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user for security (before COPY to use --chown)
RUN useradd -m -s /bin/bash hpc

# Copy spack install tree and view from builder.
WORKDIR /opt

# 1. Spack install tree (real files: binaries, libraries, data)
COPY --from=builder --chown=hpc:hpc /opt/spack /opt/spack

# 2. Spack view (symlinks into /opt/spack, provides unified bin/lib/share layout)
COPY --from=builder --chown=hpc:hpc /opt/spack-view /opt/spack-view

# 3. VASP testsuite for regtesting
COPY --from=builder --chown=hpc:hpc /opt/vasp-testsuite /opt/vasp-testsuite

# 4. fakeintel library for AMD CPU compatibility
COPY --from=builder --chown=hpc:hpc /opt/libfakeintel /opt/libfakeintel

# Copy test config files
COPY --chmod=644 spack-envs/{{ env_dir_name }}/testsuite-file/spack_build_test.conf /opt/vasp-testsuite/testsuite/
COPY --chmod=644 spack-envs/{{ env_dir_name }}/testsuite-file/spack_build_test_fast.conf /opt/vasp-testsuite/testsuite/

# Register spack library paths with ldconfig for system-wide discovery.
RUN { echo "/opt/spack-view/lib"; } > /etc/ld.so.conf.d/vasp.conf && \
    ldconfig

# ----------------------------------------------------------------------------
# RUNTIME CLEANUP: Remove development-only content to minimize image size
# ----------------------------------------------------------------------------
RUN echo "=== Runtime cleanup: removing development-only content ===" && \
    BEFORE=$(du -sm / 2>/dev/null | cut -f1) && \
    echo "Before: ${BEFORE}MB" && \
    \
    echo "--- [1/8] Purging system compiler packages ---" && \
    apt-get purge -y --auto-remove \
        gcc-14 gcc-14-x86-64-linux-gnu \
        gfortran-14 gfortran-14-x86-64-linux-gnu \
        cpp-14 cpp-14-x86-64-linux-gnu \
        libgcc-14-dev libgfortran-14-dev \
        gcc gfortran cpp 2>/dev/null || true && \
    apt-get autoremove -y 2>/dev/null || true && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    \
    echo "--- [2/8] Removing headers (include/) ---" && \
    find /opt/spack/linux-* -type d -name include -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /opt/spack-view/include && \
    rm -rf /usr/include && \
    \
    echo "--- [3/8] Removing Python bytecode cache ---" && \
    find /opt/spack -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    \
    echo "--- [4/8] Removing Python test/idle/tkinter ---" && \
    for pydir in /opt/spack/linux-*/python-*/lib/python*/; do \
        rm -rf "${pydir}test" "${pydir}idlelib" "${pydir}turtledemo" "${pydir}tkinter" 2>/dev/null || true; \
    done && \
    \
    echo "--- [5/8] Removing docs and man pages ---" && \
    find /opt/spack -type d -name doc -path "*/share/*" -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/spack -type d -name man -path "*/share/*" -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /opt/spack-view/share/doc /opt/spack-view/share/man && \
    \
    echo "--- [6/8] Removing .spack metadata ---" && \
    find /opt/spack -type d -name .spack -exec rm -rf {} + 2>/dev/null || true && \
    \
    echo "--- [7/8] Removing cmake/pkgconfig ---" && \
    find /opt/spack -type d -name cmake -path "*/lib/*" -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/spack -type d -name pkgconfig -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /opt/spack-view/cmake /opt/spack-view/lib/cmake /opt/spack-view/lib/pkgconfig && \
    \
    echo "--- [8/8] Removing static libraries (.a) ---" && \
    find /opt -name "*.a" -delete 2>/dev/null || true && \
    \
    AFTER=$(du -sm / 2>/dev/null | cut -f1) && \
    echo "=== Cleanup complete: ${BEFORE}MB → ${AFTER}MB (saved $((BEFORE - AFTER))MB) ==="

# Create workspace directory
RUN mkdir -p /workspace && chown hpc:hpc /workspace

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER hpc

# ============================================================================
# STAGE 3: FINAL - Alias for runtime (for backward compatibility)
# ============================================================================
FROM runtime AS final

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

LABEL version="6.6.0" \
      description="Optimized VASP 6.6.0 container" \
      maintainer="s8ga" \
      image_name="{{ default_image_name }}" \
      image_tag="{{ default_image_tag }}" \
      timestamp="{{ timestamp }}"

# Container identity for MOTD and runtime inspection.
ENV HPC_CONTAINER_NAME="{{ default_image_name }}" \
    HPC_CONTAINER_TAG="{{ default_image_tag }}" \
    HPC_CONTAINER_BUILD_TS="{{ timestamp }}"

ENV MPI_RUNVAR=" --allow-run-as-root --bind-to core -x OMP_STACKSIZE=512m -x OMP_PLACES=cores -x OMP_PROC_BIND=close " \
    MPI_AMDRUNVAR=" --allow-run-as-root --bind-to core -x LD_PRELOAD=/opt/libfakeintel/libfakeintel.so -x OMP_STACKSIZE=512m -x OMP_PLACES=cores -x OMP_PROC_BIND=close "

# Fixed Language releated issue
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
    
# MOTD system: shown only for interactive shell sessions.
COPY --chmod=755 scripts/vasp-motd.sh /usr/local/bin/hpc-motd.sh
COPY --chmod=755 scripts/vasp-entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]

{% endif %}

# ============================================================================
# END OF DOCKERFILE
# ============================================================================
