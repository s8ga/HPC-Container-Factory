# Multi-stage Dockerfile for VASP 6.6.1 + Intel oneMKL with Spack (AVX512)
# BUILD REQUIREMENTS:
# - assets/ directory with spack-v{{ spack_version }}.tar.gz, bootstrap-{{ spack_version }}, spack-mirror (optional)
# - spack-envs/{{ env_dir_name }}/spack-env-file with spack.yaml and spack.lock
# - assets/manual-packages/vasp.6.6.1.tgz (private source, not in spack-mirror or buildcache)
#
# NOTE: Do not reorder or edit RUN steps within each stage; that breaks Docker layer cache.

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

# ============================================================================
# STAGE 1: BUILDER-INSTALLED - VASP compilation environment before cleanup
# ============================================================================
FROM {{ builder_base_image }} AS builder-installed

LABEL stage="builder-installed" \
      description="Installed stage: Compiles VASP 6.6.1 with Spack" \
      maintainer="s8ga"

# ============================================================================
# BUILDER BASE - common Spack prelude (APT + install + bootstrap + mirror)
# ============================================================================
{% include 'partials/spack_builder_prelude_debian.j2' %}

# ============================================================================
# VASP-SPECIFIC BUILD
# ============================================================================

# Stage s8ga vasp + s8_overrides at the pinned s8ga monorepo commit (plan-driven; data from env.yaml custom_repos).
{% include 'partials/spack_staging_clones.j2' %}

{% include 'partials/spack_env_create.j2' %}
{% include 'partials/spack_update_builtin.j2' %}
{% include 'partials/spack_compiler_find.j2' %}

# Repo priority: builtin < vasp < s8_overrides (env scope).
# Paths come from plan (custom_repos[].image_path via spack_image_repos).
{% include 'partials/spack_image_repos.j2' %}

RUN spack -e {{ spack_env_name }} repo ls

{% include 'partials/spack_zlib_fix.j2' %}
{% include 'partials/spack_buildcache_config.j2' %}

# Prepare fakeintel library to work around MKL's CPU dispatching on AMD CPUs.
COPY spack-envs/{{ env_dir_name }}/libfakeintel /opt/libfakeintel/

# Output .so at /opt/libfakeintel/libfakeintel.so.
RUN make -C /opt/libfakeintel/ all

# Install VASP dependencies first (eligible for binary buildcache; proprietary vasp excluded).
{% if spack_buildcache_policy in ['auto', 'only'] %}
{% include 'partials/spack_buildcache_install_deps.j2' %}
{% else %}
{% set _excl_csv = spack_buildcache_exclude_specs | default([]) | join(',') %}
{% set _excl_args = spack_buildcache_exclude_specs | default(['vasp'], true) | join(' ') %}
RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
    bash -o pipefail -c 'set -euo pipefail; \
        spack -e {{ spack_env_name }} install --only-concrete --only dependencies --fail-fast -j "$(nproc)" -p 20 {{ _excl_args }}; \
        mapfile -t _hpc_cf_extra_roots < <(spack -e {{ spack_env_name }} python -c \
            "import spack.environment as ev; e=ev.active_environment(); excl={x for x in \"{{ _excl_csv }}\".split(\",\") if x}; print(chr(10).join(\"/\"+x.hash for x in e.explicit_roots() if (not e.specs_by_hash[x.hash].external) and (not e.specs_by_hash[x.hash].installed) and (e.specs_by_hash[x.hash].name not in excl)))"); \
        if [ -n "${_hpc_cf_extra_roots[0]:-}" ]; then \
            spack -e {{ spack_env_name }} install --only-concrete --fail-fast -j "$(nproc)" -p 20 "${_hpc_cf_extra_roots[@]}"; \
        fi'
{% endif %}

{% if not spack_buildcache_producer %}
# Copy manual (private) source packages into container (consumer / normal build only;
# buildcache producer never copies or builds proprietary VASP).
{% for mp in manual_packages %}
COPY {{ mp.file }} {{ mp.dest }}
{% endfor %}

# Prepare VASP working directory for manual_download url = "file://{cwd}/vasp.6.6.1.tgz".
RUN mkdir -p /opt/vasp && \
    cp /opt/manual-package/vasp.6.6.1.tgz /opt/vasp/ && \
    echo "✅ VASP source tarball ready: $(ls /opt/vasp/)"

# Install VASP itself locally (--use-buildcache never) with --keep-stage for testsuite extraction.
RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
        cd /opt/vasp && \
        spack -e {{ spack_env_name }} install --only-concrete --use-buildcache never --fail-fast -j "$(nproc)" -p 20 --keep-stage vasp;

# Extract VASP testsuite from the spack stage directory and build helper tool.
RUN VASP_STAGE=$(spack -e {{ spack_env_name }} location -s vasp) && \
    echo "VASP stage: ${VASP_STAGE}" && \
    mkdir -p /opt/vasp-testsuite && \
    cp -a "${VASP_STAGE}/spack-src/testsuite" /opt/vasp-testsuite/testsuite && \
    cd /opt/vasp-testsuite/testsuite && \
    sed -i '/^include.*makefile\.include/d' makefile && \
    make numbertable && \
    echo "✅ Testsuite extracted: $(du -sh /opt/vasp-testsuite/testsuite | cut -f1)"
{% endif %}

# ============================================================================
# STAGE 2: BUILDER - post-install / debug checkpoint
# ============================================================================
FROM builder-installed AS builder

LABEL stage="builder" \
      description="Builder stage: post-install VASP 6.6.1 debug image" \
      maintainer="s8ga"

# Purge MKL's unused compiler runtime and IntelMPI payloads in Stage 2 so the
# Stage 1 producer tree stays intact for `spack buildcache push`.
RUN . ${SPACK_ROOT}/share/spack/setup-env.sh && \
    spack env activate {{ spack_env_name }} && \
    MKL_TRUELOCATION=$(spack location -i intel-oneapi-mkl) && \
    rm -rf "${MKL_TRUELOCATION}/compiler" && \
    rm -rf "${MKL_TRUELOCATION}/mpi" && \
    find "${MKL_TRUELOCATION}" -name "libmkl_blacs_intelmpi*" -delete && \
    find "${MKL_TRUELOCATION}" -name "libmkl_blacs_sgimpt*"   -delete && \
    find "${MKL_TRUELOCATION}" -name "libmkl_intel_thread*"   -delete

{% set build_manifest_title = "VASP 6.6.1 Build Manifest" %}
{% include 'partials/spack_post_install.j2' %}

{% if not build_only %}
# ============================================================================
# STAGE 3: RUNTIME - Minimal container with only VASP and runtime libraries
# ============================================================================
FROM {{ runtime_base_image }} AS runtime

LABEL stage="runtime" \
      description="Runtime stage: Minimal container with VASP 6.6.1 only" \
      maintainer="s8ga"

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/spack-view/bin:/opt/bin:$PATH"

{% include 'partials/runtime_apt_debian.j2' %}

# Create non-root user for security (before COPY to use --chown)
RUN useradd -m -s /bin/bash hpc

# Copy spack install tree and view from builder.
WORKDIR /opt

# 1. Spack install tree (real files: binaries, libraries, data)
COPY --from=builder --chown=hpc:hpc /opt/spack /opt/spack

# 2. Spack view (symlinks into /opt/spack, provides unified bin/lib/share layout)
COPY --from=builder --chown=hpc:hpc /opt/spack-view /opt/spack-view

# 3. VASP testsuite for regtesting
COPY --from=builder --chown=hpc:hpc /opt/vasp-testsuite /opt/vasp-testsuite

# 4. fakeintel library for AMD CPU compatibility
COPY --from=builder --chown=hpc:hpc /opt/libfakeintel /opt/libfakeintel

# Copy test config files
COPY --chmod=644 spack-envs/{{ env_dir_name }}/testsuite-file/spack_build_test.conf /opt/vasp-testsuite/testsuite/
COPY --chmod=644 spack-envs/{{ env_dir_name }}/testsuite-file/spack_build_test_fast.conf /opt/vasp-testsuite/testsuite/

# Register spack library paths with ldconfig for system-wide discovery.
RUN { echo "/opt/spack-view/lib"; } > /etc/ld.so.conf.d/vasp.conf && \
    ldconfig

{% include 'partials/runtime_cleanup.j2' %}

# Create workspace directory
RUN mkdir -p /workspace && chown hpc:hpc /workspace

WORKDIR /workspace

USER hpc

# ============================================================================
# STAGE 4: FINAL - Alias for runtime (for backward compatibility)
# ============================================================================
FROM runtime AS final

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

LABEL version="6.6.1" \
      description="Optimized VASP 6.6.1 container (AVX512)" \
      maintainer="s8ga" \
      image_name="{{ default_image_name }}" \
      image_tag="{{ default_image_tag }}" \
      timestamp="{{ timestamp }}"

# Container identity for MOTD and runtime inspection.
ENV HPC_CONTAINER_NAME="{{ default_image_name }}" \
    HPC_CONTAINER_TAG="{{ default_image_tag }}" \
    HPC_CONTAINER_BUILD_TS="{{ timestamp }}"

# Force-OpenMP preset: image-wide OMP defaults, no mpirun binding.
# Hybrid layouts are tuned purely via `mpirun -x OMP_NUM_THREADS=<x>`.
ENV OMP_NUM_THREADS=1 \
    OMP_STACKSIZE=512m \
    MPI_RUNVAR=" --allow-run-as-root --bind-to none -x OMP_NUM_THREADS -x OMP_STACKSIZE=512m " \
    MPI_AMDRUNVAR=" --allow-run-as-root --bind-to none -x LD_PRELOAD=/opt/libfakeintel/libfakeintel.so -x OMP_NUM_THREADS -x OMP_STACKSIZE=512m "

# MOTD system: shown only for interactive shell sessions.
COPY --chmod=755 scripts/vasp-force-openmp-motd.sh /usr/local/bin/hpc-motd.sh
COPY --chmod=755 scripts/vasp-entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]

{% endif %}

# ============================================================================
# END OF DOCKERFILE
# ============================================================================
