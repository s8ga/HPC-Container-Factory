-/** Translate an MKLMPI_Comm into MPI_Comm. */
+
+/* =========================================================================
+ * HANDLE TRANSLATION HELPERS
+ *
+ * On MPICH-family MPIs: MPI handles are integers, so f2c/c2f are identity.
+ * On OpenMPI:           MPI handles are pointers; direct cast causes SIGSEGV.
+ *                       f2c/c2f perform the required integer<->pointer lookup.
+ * ========================================================================= */
+
+/**
+ * v4 — Threshold + Alignment dual filter.
+ *
+ *  Decision matrix on x86-64:
+ *
+ *  Input xcomm          | < 64KB threshold? | 16B aligned? | Decision
+ *  ─────────────────────┼───────────────────┼──────────────┼──────────
+ *  Fortran handle 3     | YES (< 64KB)      | NO           | f2c(3) ✓
+ *  Fortran handle 16    | YES (< 64KB)      | YES          | f2c(16) ✓ (threshold saves us!)
+ *  C ptr 0x00601000     | NO  (≥ 64KB)      | YES          | direct cast ✓
+ *  C ptr 0x7f...b80     | NO  (≥ 64KB)      | YES          | direct cast ✓
+ *  C ptr 0x00601001     | NO  (≥ 64KB)      | NO           | f2c() ← misaligned ptr (impossible from malloc)
+ *  garbage 0xDEADBEEF   | NO  (≥ 64KB)      | NO           | f2c() ← will fail fast, safe
+ *
+ *  Threshold 64KB guarantees:
+ *    - All practical Fortran handles (< 1000) are always caught
+ *    - x86-64 NULL guard page (0-4095) is always caught
+ *    - Minimum heap address (~6MB non-PIE) is above threshold
+ *
+ *  Alignment 16B guarantees:
+ *    - malloc'd C pointers always pass
+ *    - Misaligned garbage always falls to Fortran path (fails fast at f2c)
+ */
+
+#include <stdint.h>
+
+#define X2COMM_ADDR_THRESHOLD ((uintptr_t)0x10000)  /* 64 KB */
+
 static MPI_Comm X2COMM(MKLMPI_Comm xcomm)
 {
     if (xcomm == MKLMPI_COMM_WORLD) return MPI_COMM_WORLD;
     if (xcomm == MKLMPI_COMM_NULL)  return MPI_COMM_NULL;
-    return (MPI_Comm)xcomm;
+
+    uintptr_t val = (uintptr_t)xcomm;
+
+    /* Below threshold: definitely a Fortran handle (covers handles 0-65535) */
+    if (val < X2COMM_ADDR_THRESHOLD)
+        return MPI_Comm_f2c((MPI_Fint)xcomm);
+
+    /* Above threshold AND 16-byte aligned: definitely a C pointer */
+    if ((val & 0xF) == 0)
+        return (MPI_Comm)val;
+
+    /* Above threshold but NOT aligned: impossible for valid C pointer,
+       treat as Fortran handle — f2c will return MPI_COMM_NULL and fail fast */
+    return MPI_Comm_f2c((MPI_Fint)xcomm);
 }
 
