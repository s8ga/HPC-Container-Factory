# Multi-stage Dockerfile for CP2K 2026.1 with ROCm gfx942 + Spack
# BUILD REQUIREMENTS:
# - assets/ directory with spack-v{{ spack_version }}.tar.gz, bootstrap-{{ spack_version }}, spack-mirror (optional)
# - spack-envs/{{ env_dir_name }} with spack.yaml and spack.lock
#
# Self-contained template: base images come from env.yaml via generate.py.
# {{ builder_base_image }} and {{ runtime_base_image }} are injected from
# spack-envs/{{ env_dir_name }}/env.yaml → images.builder / images.runtime.
#
# NOTE: Do not reorder or edit RUN steps within each stage; that breaks Docker layer cache.

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

# ============================================================================
# STAGE 1: BUILDER - CP2K + ROCm compilation environment
# ============================================================================
FROM {{ builder_base_image }} AS builder

LABEL stage="builder" \
      description="Builder stage: Compiles CP2K 2026.1 with ROCm gfx942 via Spack" \
      maintainer="s8ga" \
      upstream_repo="https://github.com/amd/InfinityHub-CI" \
      upstream_component="cp2k/docker/cp2k_environment"

ENV DEBIAN_FRONTEND=noninteractive

{% include 'partials/locale_c_utf8.j2' %}

# Build arguments for GPU target and parallelism (kept for flexibility).
ARG AMDGPU_TARGETS="gfx942"
ARG SPACK_MAKE_JOBS=0

# ============================================================================
# BUILDER BASE - ROCm/Ubuntu deps + shared Spack install/bootstrap/mirror
# ============================================================================

# Configure APT mirrors to use USTC for faster downloads in China
# Note: Ubuntu uses .sources format in /etc/apt/sources.list.d/
RUN sed -i 's|//.*archive.ubuntu.com|//mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|//security.ubuntu.com|//mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true

# System dependencies for Spack and compilation
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    environment-modules \
    gfortran \
    git \
    openssh-client \
    openssh-server \
    pkg-config \
    unzip \
    wget \
    rsync \
    nano \
    cmake \
    file \
    automake \
    bzip2 \
    xxd \
    xz-utils \
    zstd \
    ninja-build \
    patch \
    pkgconf \
    libtool-bin \
    lsb-release \
    python3 \
    python3-pip \
    python3-venv \
    binutils \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt

# Copy pre-downloaded Spack from assets and extract in builder container
# This avoids network issues and git clone limitations in containers
{% include 'partials/spack_install.j2' %}

{% include 'partials/spack_bootstrap.j2' %}
{% include 'partials/spack_mirror.j2' %}

{% include 'partials/spack_build_dirs.j2' %}

# ============================================================================
# CP2K-SPECIFIC BUILD (ROCm)
# ============================================================================

# Fetch CP2K source — only the directories needed for regtesting.
# Uses sparse checkout to avoid downloading the full ~1GB+ repo.
# The actual build comes from spack (source mirror), not this clone.
RUN git clone --filter=blob:none --no-checkout -b {{ cp2k_branch }} \
        https://github.com/cp2k/cp2k.git /opt/cp2k && \
    cd /opt/cp2k && \
    git sparse-checkout init --cone && \
    git sparse-checkout set tests src/grid/sample_tasks tools/regtesting tools && \
    git checkout && \
    echo "✅ Sparse checkout done: $(du -sh /opt/cp2k | cut -f1)"

{% include 'partials/spack_env_create.j2' %}
{% include 'partials/spack_update_builtin.j2' %}
{% include 'partials/spack_compiler_find.j2' %}

# Add custom spack repo from CP2K developers and our local repo with custom package overrides
RUN mkdir -p /opt/spack-repo/spack_repo/ && \
    cp -a /opt/cp2k/{{ cp2k_dev_repo_path }}/ /opt/spack-repo/spack_repo/ && \
    spack repo add --scope {{ spack_repo_scope }} /opt/spack-repo/spack_repo/{{ cp2k_dev_repo_path.split('/')[-1] }}/ && \
    spack repo add --scope {{ spack_repo_scope }} /opt/spack-env-file/repos/ && \
    spack -e {{ spack_env_name }} repo ls

# ROCm 7.x compatibility for BLT FindHIP.cmake.
RUN ln -sf /opt/rocm /opt/rocm/hip

{% include 'partials/spack_zlib_fix.j2' %}

RUN {% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
    {% endif %}
        spack -e {{ spack_env_name }} install --fail-fast -j "$(nproc)" -p 20 --only dependencies libint && \

        echo; \
        echo "Installing libint..."; \
        echo "Note: libint is a critical dependency that often takes the longest to build."; \
        echo; \

        spack -e {{ spack_env_name }} install --fail-fast -j "$(nproc)" -p 20 libint & \

        sleep 5 && \

        echo; \
        echo "Concurrently Install cp2k and it's dependencies..."; \
        echo; \

        spack -e {{ spack_env_name }} install --fail-fast -j "$(nproc)" -p 20;
{% include 'partials/spack_view_enable.j2' %}

{% include 'partials/spack_strip.j2' %}

# ----------------------------------------------------------------------------
# STEP: Build manifest
# ----------------------------------------------------------------------------
RUN . ${SPACK_ROOT}/share/spack/setup-env.sh && spack -e {{ spack_env_name }} env activate --sh > /tmp/env.sh && \
    . /tmp/env.sh && \
    { echo "=== CP2K 2026.1 ROCm Build Manifest ==="; \
      echo "View: $(du -sh /opt/spack-view/ | cut -f1)"; \
      echo "Install tree: $(du -sh /opt/spack/ | cut -f1)"; \
      echo ""; spack find -d; } > /opt/spack-view/BUILD_MANIFEST.txt && \
    echo "=== Generating Dependency Graph ===" && \
    spack -e {{ spack_env_name }} graph --color --dot > /opt/spack-view/DependencyGraph.dot && \
    echo "Manifest saved: $(wc -l < /opt/spack-view/BUILD_MANIFEST.txt) lines"

# ----------------------------------------------------------------------------
# STEP: Selective ROCm compute library export
# ----------------------------------------------------------------------------
# The runtime base image (rocm/dev-ubuntu-24.04:7.2.1, non-complete) already
# includes core ROCm runtime libs: libamdhip64, libamd_comgr, libhiprtc,
# libhsa-runtime64, librocprofiler-register, libroctx64.
# We only need to copy the compute libraries that are absent in non-complete:
#   librocblas, libhipblas, libhipblaslt, libhipfft, librocfft,
#   librocsolver, librocroller + kernel data dirs.
# This reduces the ROCm COPY layer from ~13.3GB to ~5.8GB.
RUN bash -c 'set -euo pipefail; \
    echo "=== Selective ROCm library export ==="; \
    ROCM_ARCH="${AMDGPU_TARGETS%%,*}"; \
    rm -rf /opt/rocm-export; mkdir -p /opt/rocm-export/lib; \
    for lib in librocblas libhipblas libhipblaslt libhipfft librocfft librocsolver librocroller; do \
        for f in /opt/rocm/lib/${lib}*; do \
            if [[ -e "${f}" ]]; then cp -a "${f}" /opt/rocm-export/lib/; fi; \
        done; \
    done; \
    if [[ -d /opt/rocm/lib/rocblas/library ]]; then \
        mkdir -p /opt/rocm-export/lib/rocblas/library; \
        cp -a /opt/rocm/lib/rocblas/library/*${ROCM_ARCH}* /opt/rocm-export/lib/rocblas/library/ 2>/dev/null || true; \
        cp -a /opt/rocm/lib/rocblas/library/TensileLibrary.dat /opt/rocm-export/lib/rocblas/library/ 2>/dev/null || true; \
    fi; \
    if [[ -d /opt/rocm/lib/hipblaslt/library ]]; then \
        mkdir -p /opt/rocm-export/lib/hipblaslt/library; \
        cp -a /opt/rocm/lib/hipblaslt/library/*${ROCM_ARCH}* /opt/rocm-export/lib/hipblaslt/library/ 2>/dev/null || true; \
    fi; \
    if [[ -d /opt/rocm/lib/rocfft ]]; then \
        cp -a /opt/rocm/lib/rocfft /opt/rocm-export/lib/; \
    fi; \
    echo "Exported ROCm libs: $(du -sm /opt/rocm-export/lib/ | cut -f1)MB"; \
    echo "Files: $(find /opt/rocm-export/lib -type f | wc -l)"'

{% if not build_only %}
# ============================================================================
# STAGE 2: RUNTIME - Minimal container with CP2K + ROCm runtime libraries
# ============================================================================
FROM {{ runtime_base_image }} AS runtime

LABEL stage="runtime" \
      description="Runtime stage: Minimal container with CP2K 2026.1 + ROCm gfx942" \
      maintainer="s8ga"

# Minimal runtime: only cp2k.psmp + mpirun + required .so files
# Spack view provides all spack-built binaries and libraries via symlinks.
# ROCm compute libs (buildable:false externals) are copied separately from /opt/rocm.
# PATH points to the view for transparent binary access.
# LD_LIBRARY_PATH is set only for ROCm (/opt/rocm/lib) — spack-view libs are
# resolved via ldconfig (registered in /etc/ld.so.conf.d/cp2k.conf).
# This avoids polluting system tools (nano, screen) with Spack-built libs.
# CP2K_DATA_DIR points to data files installed by spack (basis sets, potentials, etc.)

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/spack-view/bin:/opt/bin:$PATH" \
    LD_LIBRARY_PATH="/opt/rocm/lib:${LD_LIBRARY_PATH}" \
    CP2K_DATA_DIR="/opt/spack-view/share/cp2k/data" \
    ROCM_PATH="/opt/rocm" \
    HIP_PLATFORM="amd"

{% include 'partials/locale_c_utf8.j2' %}

# Configure APT mirrors to use USTC for faster downloads in China
RUN sed -i 's|//.*archive.ubuntu.com|//mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|//security.ubuntu.com|//mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true

# Install minimal runtime dependencies (system libraries not included in spack view)
# Note: Spack links against runtime libs (libgfortran5, libstdc++6, libgcc-s1).
# We install them explicitly plus common tools for user convenience.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates \
    bash \
    python3 \
    curl \
    tar \
    libgfortran5 \
    libstdc++6 \
    libgcc-s1 \
    libnuma1 \
    openssh-client \
    util-linux \
    libdw-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user for security (before COPY to use --chown)
RUN useradd -m -s /bin/bash hpc


# Copy spack install tree and view from builder.
# NOTE: Docker COPY preserves symlinks — the view's symlinks will point correctly
# because we copy the install tree first, then the view on top.
# ROCm compute libs are buildable:false externals — not in spack install tree,
# so they must be copied separately from the builder's /opt/rocm/.
WORKDIR /opt

# 1. Spack install tree (real files: binaries, libraries, data)
COPY --from=builder --chown=hpc:hpc /opt/spack /opt/spack

# 2. Spack view (symlinks into /opt/spack, provides unified bin/lib/share layout)
COPY --from=builder --chown=hpc:hpc /opt/spack-view /opt/spack-view

# 3. CP2K test files for regtesting (sparse-checkout from git clone in builder)
COPY --from=builder --chown=hpc:hpc /opt/cp2k/tests /opt/cp2k/tests
COPY --from=builder --chown=hpc:hpc /opt/cp2k/src/grid/sample_tasks /opt/cp2k/src/grid/sample_tasks
COPY --from=builder --chown=hpc:hpc /opt/cp2k/tools/regtesting /opt/cp2k/tools/regtesting

# 4. ROCm compute libraries (buildable:false externals, not in spack install tree)
#    Selective copy: only the compute libs missing from non-complete runtime image.
#    Core runtime libs (libamdhip64, libamd_comgr, libhiprtc, etc.) come from
#    the runtime base image (rocm/dev-ubuntu-24.04:7.2.1) and are NOT overwritten.
COPY --from=builder /opt/rocm-export/lib /opt/rocm/lib

# Register spack + ROCm library paths with ldconfig for system-wide discovery.
RUN { echo "/opt/spack-view/lib"; echo "/opt/rocm/lib"; } > /etc/ld.so.conf.d/cp2k.conf && \
    ldconfig

# ----------------------------------------------------------------------------
# RUNTIME CLEANUP: Remove development-only content to minimize image size
# ----------------------------------------------------------------------------
# CP2K uses Spack's own gcc-runtime for libgfortran/libstdc++/libgcc_s.
# System gcc/gfortran may be pulled in as recommends of libgfortran5/libstdc++6
# but are NOT needed at runtime. Safe to purge.
#
# NOTE: The ROCm runtime base image (rocm/dev-ubuntu-24.04:7.2.1, non-complete)
# ships gcc-13 (not gcc-14 like stock Ubuntu 24.04). We must purge gcc-13
# and its dev packages. hipcc/rocm-llvm are build-time tools, not needed at
# runtime for CP2K (cp2k.psmp does not link them).
#
# NOT removed: cp2k/share/cp2k/data/ (basis sets, potentials — runtime needed)
# NOT removed: /opt/rocm-7.2.1/lib/lib*.so (ROCm runtime libs — essential)
RUN echo "=== Runtime cleanup: removing development-only content ===" && \
    BEFORE=$(du -sm / 2>/dev/null | cut -f1) && \
    echo "Before: ${BEFORE}MB" && \
    \
    echo "--- [1/8] Removing system compiler binaries (gcc-13 from ROCm base) ---" && \
    rm -rf /usr/bin/gcc* /usr/bin/g++* /usr/bin/cpp* /usr/bin/gfortran* 2>/dev/null || true && \
    rm -rf /usr/lib/gcc 2>/dev/null || true && \
    rm -rf /usr/libexec/gcc 2>/dev/null || true && \
    rm -rf /usr/include/c++ 2>/dev/null || true && \
    \
    echo "--- [2/8] Removing headers (include/) ---" && \
    find /opt/spack/linux-* -type d -name include -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /opt/spack-view/include && \
    rm -rf /usr/include && \
    \
    echo "--- [3/8] Removing Python bytecode cache ---" && \
    find /opt/spack -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    \
    echo "--- [4/8] Removing Python test/idle/tkinter ---" && \
    for pydir in /opt/spack/linux-*/python-*/lib/python*/; do \
        rm -rf "${pydir}test" "${pydir}idlelib" "${pydir}turtledemo" "${pydir}tkinter" 2>/dev/null || true; \
    done && \
    \
    echo "--- [5/8] Removing docs and man pages ---" && \
    find /opt/spack -type d -name doc -path "*/share/*" -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/spack -type d -name man -path "*/share/*" -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /opt/spack-view/share/doc /opt/spack-view/share/man && \
    \
    echo "--- [6/8] Removing .spack metadata ---" && \
    find /opt/spack -type d -name .spack -exec rm -rf {} + 2>/dev/null || true && \
    \
    echo "--- [7/8] Removing cmake/pkgconfig and static libs ---" && \
    find /opt/spack -type d -name cmake -path "*/lib/*" -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/spack -type d -name pkgconfig -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /opt/spack-view/cmake /opt/spack-view/lib/cmake /opt/spack-view/lib/pkgconfig && \
    find /opt -name "*.a" -delete 2>/dev/null || true && \
    \
    echo "--- [8/8] Removing ROCm dev tools and LLVM build artifacts ---" && \
    rm -rf /opt/rocm-7.2.1/lib/llvm/bin 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/lib/llvm/lib-debug 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/lib/llvm/include 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/lib/llvm/share 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/bin/hipcc 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/bin/hipify* 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/bin/*.sh 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/include 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/lib/cmake 2>/dev/null || true && \
    rm -rf /opt/rocm-7.2.1/lib/pkgconfig 2>/dev/null || true && \
    \
    AFTER=$(du -sm / 2>/dev/null | cut -f1) && \
    echo "=== Cleanup complete: ${BEFORE}MB → ${AFTER}MB (saved $((BEFORE - AFTER))MB) ==="

# Create workspace directory
RUN mkdir -p /workspace && chown hpc:hpc /workspace

# Set working directory
WORKDIR /workspace

# Switch to non-root user
USER hpc

# ============================================================================
# STAGE 3: FINAL - Alias for runtime (for backward compatibility)
# ============================================================================
FROM runtime AS final

ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

LABEL version="2026.1" \
      description="CP2K 2026.1 with ROCm gfx942 support" \
      maintainer="s8ga" \
      image_name="{{ default_image_name }}" \
      image_tag="{{ default_image_tag }}" \
      timestamp="{{ timestamp }}"

# Container identity for MOTD and runtime inspection.
ENV HPC_CONTAINER_NAME="{{ default_image_name }}" \
    HPC_CONTAINER_TAG="{{ default_image_tag }}" \
    HPC_CONTAINER_BUILD_TS="{{ timestamp }}"

ENV MPI_RUNVAR=" -x OMPI_MCA_pml=ucx -x OMPI_MCA_osc=ucx -x UCX_TLS=all -x UCX_MEMTYPE_CACHE=n -x OMPI_MCA_coll_ucc_enable=1 -x OMPI_MCA_coll_ucc_priority=100 -x HSA_ENABLE_MWAITX=1 GPU_MAX_HW_QUEUES=12 -x OMP_WAIT_POLICY=PASSIVE -x OMP_PROC_BIND=close "

COPY --chmod=755 spack-envs/{{ env_dir_name }}/cp2k-gpu-motd.sh /usr/local/bin/hpc-motd.sh

# Docker/Podman: entrypoint that conditionally shows MOTD
COPY --chmod=755 scripts/cp2k-entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]

{% endif %}

# ============================================================================
# END OF DOCKERFILE
# ============================================================================
