{# Shared 2-stage Fedora Dockerfile template for method: spack environments. #}
{# Expects context from hpc_cf.template.build_context + spack_plan.plan_context. #}
ARG DEFAULT_IMAGE_NAME="{{ default_image_name }}"
ARG DEFAULT_IMAGE_TAG="{{ default_image_tag }}"

# ============================================================================
# STAGE 1: BUILDER - Compile Spack packages, push buildcache or finalize tree
# ============================================================================
FROM {{ builder_base_image }} AS builder

LABEL stage="builder" \
      description="Builder stage: {{ default_image_name }}:{{ default_image_tag }}" \
      maintainer="s8ga"

{% include 'partials/spack_builder_prelude_fedora.j2' %}

{% if cp2k_branch is defined %}
{% include 'partials/cp2k_upstream_clone.j2' %}
{% endif %}

{% include 'partials/spack_staging_clones.j2' %}

{% include 'partials/spack_env_create.j2' %}
{% include 'partials/spack_update_builtin.j2' %}
{% include 'partials/spack_compiler_find.j2' %}

{% if cp2k_dev_repo_path is defined and cp2k_dev_repo_path %}
RUN mkdir -p /opt/spack-repo/spack_repo/ && \
    cp -a /opt/cp2k/{{ cp2k_dev_repo_path }}/ /opt/spack-repo/spack_repo/
{% endif %}

{% include 'partials/spack_image_repos.j2' %}

RUN spack -e {{ spack_env_name }} repo ls

{% include 'partials/spack_zlib_fix.j2' %}
{% include 'partials/spack_buildcache_config.j2' %}

{% if cp2k_branch is defined %}{% set libint_parallel_cap = 12 %}{% endif %}
{% set spack_inline_consumer_finalize = true %}
{% set build_manifest_title = (cp2k_branch ~ " Build Manifest") if cp2k_branch is defined else (env_dir_name ~ " Build Manifest") %}
{% if spack_buildcache_policy in ['auto', 'only'] %}
{% include 'partials/spack_buildcache_install.j2' %}
{% else %}
RUN \
{% if use_mirror %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
{% endif %}
    bash -o pipefail -c 'set -euo pipefail; \
{% if libint_parallel_cap is defined and libint_parallel_cap %}
    libint_jobs="$(nproc)"; \
    if [ "${libint_jobs}" -gt {{ libint_parallel_cap | int }} ]; then libint_jobs={{ libint_parallel_cap | int }}; fi; \
    echo "Installing libint with -j ${libint_jobs} (memory-capped)..."; \
    spack -e {{ spack_env_name }} install --fail-fast -j "${libint_jobs}" -p 20 libint; \
    echo "Installing remaining packages with -j $(nproc)..."; \
    spack -e {{ spack_env_name }} install --fail-fast -j "$(nproc)" -p 20; \
{% else %}
    spack -e {{ spack_env_name }} install --fail-fast -j "$(nproc)" -p 20; \
{% endif %}
{% if not spack_buildcache_producer %}
{% include 'partials/spack_consumer_finalize_body.j2' %}'
{% else %}
    true'
{% endif %}
{% endif %}

{% if not build_only %}
# ============================================================================
# STAGE 2: RUNTIME - Minimal Fedora 45 runtime image
# ============================================================================
FROM {{ runtime_base_image }} AS runtime

LABEL stage="runtime" \
      description="Runtime stage: {{ default_image_name }}:{{ default_image_tag }}" \
      maintainer="s8ga" \
      image_name="{{ default_image_name }}" \
      image_tag="{{ default_image_tag }}" \
      timestamp="{{ timestamp }}"

{% include 'partials/locale_c_utf8.j2' %}

# Freeze to Fedora GA repos, apply pkg_mirror (USTC by default locally), install minimal runtime libs, create user hpc.
RUN sed -i 's|^enabled=1|enabled=0|g' \
        /usr/share/dnf5/repos.d/*updates*.repo /etc/yum.repos.d/*updates*.repo \
        /usr/share/dnf5/repos.d/*openh264*.repo /etc/yum.repos.d/*openh264*.repo 2>/dev/null || true && \
{% if pkg_mirror and pkg_mirror != 'official' %}
    sed -i -e 's|^metalink=|#metalink=|g' \
           -e 's|^#baseurl=https\?://download\.example/pub/fedora/linux|baseurl=https://{{ pkg_mirror }}/fedora|g' \
           -e 's|^baseurl=https\?://download\.fedoraproject\.org/pub/fedora/linux|baseurl=https://{{ pkg_mirror }}/fedora|g' \
           /usr/share/dnf5/repos.d/fedora*.repo /etc/yum.repos.d/fedora*.repo 2>/dev/null || true && \
{% endif %}
    dnf5 install -y --allowerasing --setopt=install_weak_deps=0 --disablerepo='updates*,fedora-cisco-openh264' \
        bash \
        ca-certificates \
        findutils \
        hostname \
        libatomic \
        libgfortran \
        libgomp \
        libquadmath \
        libstdc++ \
        numactl-libs \
        openssh-clients \
        procps-ng \
        tar \
        which \
{% if runtime_extra_pkgs is defined and runtime_extra_pkgs %}
{% for pkg in runtime_extra_pkgs %}
        {{ pkg }} \
{% endfor %}
{% endif %}
    && dnf5 clean all && rm -rf /var/cache/libdnf5 /var/cache/dnf /var/cache/yum \
    && useradd -m -u 1000 -s /bin/bash hpc \
    && mkdir -p /workspace && chown 1000:1000 /workspace

WORKDIR /opt

COPY --from=builder /opt/spack /opt/spack
COPY --from=builder /opt/spack-view /opt/spack-view
COPY --from=builder /opt/hpc-container-ident /etc/hpc-container-ident

{% if cp2k_branch is defined %}
COPY --from=builder /opt/cp2k/tests /opt/cp2k/tests
COPY --from=builder /opt/cp2k/src/grid/sample_tasks /opt/cp2k/src/grid/sample_tasks
COPY --from=builder /opt/cp2k/tools/regtesting /opt/cp2k/tools/regtesting

ENV GAUXC_SKALA_MODEL="{{ gauxc_skala_model | default('/opt/spack-view/share/gauxc/onedft_models/skala-1.1-rev1.fun') }}" \
    CP2K_DATA_DIR="/opt/spack-view/share/cp2k/data" \
    MPI_RUNVAR=" --bind-to none "

RUN test -f "${GAUXC_SKALA_MODEL}" \
    || test "$(find /opt/spack-view/share/gauxc/onedft_models -maxdepth 1 -name 'skala-*.fun' | wc -l)" -eq 1
{% endif %}

RUN echo "/opt/spack-view/lib" > /etc/ld.so.conf.d/spack.conf && ldconfig

ENV PATH="/opt/spack-view/bin:/opt/bin:${PATH}" \
    HPC_CONTAINER_NAME="{{ default_image_name }}" \
    HPC_CONTAINER_TAG="{{ default_image_tag }}" \
    HPC_CONTAINER_BUILD_TS="{{ timestamp }}" \
    SINGULARITY_SHELL="/usr/local/bin/hpc-shell-wrapper.sh"

WORKDIR /workspace
USER hpc

COPY --chmod=755 scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=755 {% if cp2k_branch is defined %}scripts/cp2k-motd.sh{% else %}scripts/hpc-motd.sh{% endif %} /usr/local/bin/hpc-motd.sh
COPY --chmod=755 scripts/hpc-shell-wrapper.sh /usr/local/bin/hpc-shell-wrapper.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
{% endif %}
