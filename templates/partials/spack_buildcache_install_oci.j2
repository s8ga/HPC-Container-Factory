{# Install from the OCI registry binary cache (consumer or producer).
   OCI producer pushes installed specs inline (on top of --autopush), writes
   /opt/hpc-cf-oci-publish.json, and deletes /opt/spack/* /tmp/spack-build/*
   in the same RUN to avoid multi-GB layer commits. Skips update-index on
   OCI mirrors (every consumer/check-oci probes exact tags directly). Consumers
   do NOT run _hpc_cf_missing loops or autopush.

   Never emit bash array-length expansions or single quotes inside bash -c '...'. #}
RUN \
{% if spack_buildcache_policy == 'auto' and (use_mirror | default(true)) %}
    --mount=type=bind,source=assets/spack-mirror,target=/opt/spack-mirror,readonly \
{% endif %}
{% if spack_buildcache_username_var %}
    --mount=type=secret,id=buildcache-creds \
{% endif %}
    bash -o pipefail -c 'set -euo pipefail; \
{% if spack_buildcache_username_var %}
    set -a; . /run/secrets/buildcache-creds; set +a; \
{% endif %}
    spack -e {{ spack_env_name }} mirror add --scope env:{{ spack_env_name }} --unsigned binary-cache{% if spack_buildcache_producer %} \
        --autopush{% endif %}{% if spack_buildcache_username_var %} \
        --oci-username-variable {{ spack_buildcache_username_var }} \
        --oci-password-variable {{ spack_buildcache_password_var }}{% endif %} \
        {{ spack_buildcache_url }}; \
{% if libint_parallel_cap is defined and libint_parallel_cap %}
    libint_jobs="$(nproc)"; \
    if [ "${libint_jobs}" -gt {{ libint_parallel_cap | int }} ]; then libint_jobs={{ libint_parallel_cap | int }}; fi; \
{% endif %}
{% if spack_buildcache_producer %}
    set +e; \
{% if libint_parallel_cap is defined and libint_parallel_cap %}
    echo "Installing libint with -j ${libint_jobs} (memory-capped)..."; \
    spack -e {{ spack_env_name }} install --only-concrete \
        --use-buildcache {{ spack_buildcache_policy }} --fail-fast \
        -j "${libint_jobs}" -p 20 libint; \
    _hpc_cf_libint_rc=$?; \
    echo "Installing remaining packages with -j $(nproc)..."; \
    spack -e {{ spack_env_name }} install --only-concrete \
        --use-buildcache {{ spack_buildcache_policy }} --fail-fast \
        -j "$(nproc)" -p 20; \
    _hpc_cf_install_rc=$?; \
    if [ "${_hpc_cf_libint_rc}" -ne 0 ]; then _hpc_cf_install_rc="${_hpc_cf_libint_rc}"; fi; \
{% else %}
    spack -e {{ spack_env_name }} install --only-concrete \
        --use-buildcache {{ spack_buildcache_policy }} --fail-fast \
        -j "$(nproc)" -p 20; \
    _hpc_cf_install_rc=$?; \
{% endif %}
    set -e; \
    mapfile -t _hpc_cf_installed < <(spack -e {{ spack_env_name }} python /usr/local/bin/spack_dag_query.py installed-hashes{% for x in spack_buildcache_exclude_specs | default([]) %} --exclude "{{ x }}"{% endfor %}); \
    _hpc_cf_installed_count=$(spack -e {{ spack_env_name }} python /usr/local/bin/spack_dag_query.py installed-hashes --count{% for x in spack_buildcache_exclude_specs | default([]) %} --exclude "{{ x }}"{% endfor %}); \
    echo "HPC_CF_INSTALL_RC=${_hpc_cf_install_rc}"; \
    echo "HPC_CF_INSTALLED_SPEC_COUNT=${_hpc_cf_installed_count}"; \
    if [ -z "${_hpc_cf_installed[0]:-}" ]; then \
        echo "Producer install left no non-external concrete specs on disk" >&2; \
        exit 1; \
    fi; \
    spack -e {{ spack_env_name }} buildcache push --unsigned --only package --fail-fast binary-cache "${_hpc_cf_installed[@]}"; \
    spack -e {{ spack_env_name }} python /usr/local/bin/spack_dag_query.py summary{% for x in spack_buildcache_exclude_specs | default([]) %} --exclude "{{ x }}"{% endfor %} --install-rc "${_hpc_cf_install_rc}" --output /opt/hpc-cf-oci-publish.json; \
    rm -rf /opt/spack/* /tmp/spack-build/*; \
    if [ "${_hpc_cf_install_rc}" -ne 0 ]; then \
        echo "HPC_CF_PARTIAL_INSTALL=1"; \
        echo "Producer install incomplete; metadata written for partial buildcache reporting"; \
    fi'
{% else %}
{% if libint_parallel_cap is defined and libint_parallel_cap %}
    echo "Installing libint with -j ${libint_jobs} (memory-capped)..."; \
    spack -e {{ spack_env_name }} install --only-concrete \
        --use-buildcache {{ spack_buildcache_policy }} --fail-fast \
        -j "${libint_jobs}" -p 20 libint; \
    echo "Installing remaining packages with -j $(nproc)..."; \
    spack -e {{ spack_env_name }} install --only-concrete \
        --use-buildcache {{ spack_buildcache_policy }} --fail-fast \
        -j "$(nproc)" -p 20; \
{% else %}
    spack -e {{ spack_env_name }} install --only-concrete \
        --use-buildcache {{ spack_buildcache_policy }} --fail-fast \
        -j "$(nproc)" -p 20; \
{% endif %}
{% if spack_inline_consumer_finalize | default(false) %}
{% include 'partials/spack_consumer_finalize_body.j2' %}'
{% else %}
    true'
{% endif %}
{% endif %}
