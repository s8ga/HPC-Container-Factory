{# Debian builder APT mirror + Spack compile dependencies. #}
{# template_vars.apt_mirror (default mirrors.ustc.edu.cn). Empty/official skips sed. #}
{# Debian Trixie uses .sources format in /etc/apt/sources.list.d/ #}
{% if apt_mirror and apt_mirror != 'official' %}
RUN sed -i 's|deb.debian.org|{{ apt_mirror }}|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|deb.debian.org|{{ apt_mirror }}|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|security.debian.org|{{ apt_mirror }}/debian-security|g' /etc/apt/sources.list 2>/dev/null || true
{% endif %}

# System dependencies for Spack and compilation
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    curl \
    environment-modules \
    gfortran \
    git \
    openssh-client \
    pkg-config \
    unzip \
    wget \
    cmake \
    file \
    automake \
    bzip2 \
    xxd \
    xz-utils \
    zstd \
    ninja-build \
    patch \
    patchelf \
    pkgconf \
    libtool-bin \
    python3 \
    python3-pip \
    python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt
