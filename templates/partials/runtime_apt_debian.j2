{# Debian runtime APT mirror + common system libraries for Spack-built apps. #}
{# template_vars.apt_mirror (default mirrors.ustc.edu.cn). Empty/official skips sed. #}
{% include 'partials/locale_c_utf8.j2' %}

{% if apt_mirror and apt_mirror != 'official' %}
RUN sed -i 's|deb.debian.org|{{ apt_mirror }}|g' /etc/apt/sources.list.d/*.sources 2>/dev/null || true && \
    sed -i 's|deb.debian.org|{{ apt_mirror }}|g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's|security.debian.org|{{ apt_mirror }}/debian-security|g' /etc/apt/sources.list 2>/dev/null || true
{% endif %}

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ca-certificates \
    bash \
    python3 \
    curl \
    tar \
    libgfortran5 \
    libstdc++6 \
    libgcc-s1 \
    libnuma1 \
    openssh-client \
    util-linux \
{% if runtime_extra_apt_pkgs is defined and runtime_extra_apt_pkgs %}
{% for pkg in runtime_extra_apt_pkgs %}
    {{ pkg }} \
{% endfor %}
{% endif %}
    && apt-get clean && rm -rf /var/lib/apt/lists/*
