{# Register image-phase custom repos from SpackEnvironmentPlan.spack_image_repos.
   Expects plan_context keys: spack_env_name, spack_repo_scope, spack_image_repos.
   Does not COPY/clone sources — application templates must stage image_path first.
   Not wired into shipped app Dockerfiles yet (optional merge-guardrail partial). #}
{% if spack_image_repos %}
RUN set -euo pipefail; \
{%- for repo in spack_image_repos %}
    spack -e {{ spack_env_name }} repo add --scope {{ spack_repo_scope }} {{ repo.image_path }}{% if not loop.last %} && \{% endif %}
{%- endfor %}
{% endif %}
