{# Register image-phase custom repos from SpackEnvironmentPlan.spack_image_repos.
   Expects plan_context keys: spack_env_name, spack_repo_scope, spack_image_repos.
   Does not COPY/clone sources — application templates must stage image_path first.

   STATUS: Wired into ABACUS opensource and CP2K opensource force-avx512
   (2026.1 / 2026.2) Dockerfile.j2. Other shipped apps still register image
   custom repos via per-env templates + template_vars until migrated.

   All tokens are shell_quote'd (Jinja filter → shlex.quote) so spaces / quotes /
   metacharacters in config cannot break the RUN line. #}
{% if spack_image_repos %}
RUN set -euo pipefail; \
{% for repo in spack_image_repos %}
    spack -e {{ spack_env_name | shell_quote }} repo add --scope {{ spack_repo_scope | shell_quote }} {{ repo.image_path | shell_quote }}{% if not loop.last %} && \{% endif %}{{ "" }}
{% endfor %}

{% endif %}
