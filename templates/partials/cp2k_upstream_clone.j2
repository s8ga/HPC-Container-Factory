{#- Upstream CP2K source clone for regtesting (NOT recipe staging — the
    recipe repo is staged from custom_repos data). One partial, three
    variants picked by context:

    * cp2k_source_commit defined  → lock-derived (floating master track;
      the lock is the authority, so no ancestry gate: a depth-1 fetch
      cannot re-prove ancestry once the branch advances mid-run)
    * cp2k_dev_repo_commit defined → pinned (fetch commit + branch tip +
      merge-base gate so the regtests match the recipes the lock saw)
    * otherwise                    → floating clone of {{ cp2k_branch }}

    Consumes template_vars: cp2k_branch, cp2k_dev_repo_commit (pinned
    dual-write copy), cp2k_source_commit (lock_source_commits injection),
    cp2k_source_repo_url (fork override; default upstream).
-#}
{% if cp2k_source_commit is defined %}
RUN git clone --filter=blob:none --no-checkout \
        {{ cp2k_source_repo_url | default("https://github.com/cp2k/cp2k.git") }} /opt/cp2k && \
    cd /opt/cp2k && \
    git fetch --depth 1 origin "{{ cp2k_source_commit }}" && \
    git fetch --depth 1 origin "{{ cp2k_branch }}:refs/remotes/origin/{{ cp2k_branch }}" && \
    git sparse-checkout init --cone && \
    git sparse-checkout set tests src/grid/sample_tasks tools/regtesting tools && \
    git checkout "{{ cp2k_source_commit }}" && \
    echo "✅ Sparse checkout done: lock-derived commit; no ancestor gate (depth-1 fetch cannot re-prove ancestry once the branch advances mid-run — the lock is the authority)"
{% elif cp2k_dev_repo_commit is defined %}
# Branch {{ cp2k_branch }} is pinned at {{ cp2k_dev_repo_commit }} (env.yaml).
RUN git clone --filter=blob:none --no-checkout \
        {{ cp2k_source_repo_url | default("https://github.com/cp2k/cp2k.git") }} /opt/cp2k && \
    cd /opt/cp2k && \
    git fetch --depth 1 origin "{{ cp2k_dev_repo_commit }}" && \
    git fetch --depth 1 origin "{{ cp2k_branch }}:refs/remotes/origin/{{ cp2k_branch }}" && \
    git sparse-checkout init --cone && \
    git sparse-checkout set tests src/grid/sample_tasks tools/regtesting tools && \
    git checkout "{{ cp2k_dev_repo_commit }}" && \
    git merge-base --is-ancestor HEAD "origin/{{ cp2k_branch }}" || \
      { echo "ERROR: pinned commit $(git rev-parse HEAD) is not on {{ cp2k_branch }}"; exit 1; } && \
    echo "✅ Sparse checkout done: $(du -sh /opt/cp2k | cut -f1)"
{% else %}
RUN git clone --filter=blob:none --no-checkout -b {{ cp2k_branch }} \
        {{ cp2k_source_repo_url | default("https://github.com/cp2k/cp2k.git") }} /opt/cp2k && \
    cd /opt/cp2k && \
    git sparse-checkout init --cone && \
    git sparse-checkout set tests src/grid/sample_tasks tools/regtesting tools && \
    git checkout && \
    echo "✅ Sparse checkout done: $(du -sh /opt/cp2k | cut -f1)"
{% endif %}
